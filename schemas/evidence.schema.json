{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.llm-training-learning-os.invalid/schemas/evidence.schema.json",
  "title": "LLM Training Learning Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "date",
    "week",
    "task",
    "skills",
    "difficulty",
    "ai_assistance",
    "environment_scope",
    "evidence_type",
    "result_status",
    "scoring_basis",
    "error_types",
    "privacy_review",
    "regression_date"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-\\d{4}-\\d{2}-\\d{2}-W(0[1-9]|1[0-4])-[A-Z0-9_-]+$"
    },
    "date": { "type": "string", "format": "date" },
    "week": { "type": "integer", "minimum": 1, "maximum": 14 },
    "task": { "type": "string", "minLength": 3 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "difficulty": {
      "type": "string",
      "enum": ["FOUNDATION", "INTERMEDIATE", "ADVANCED", "TRANSFER"]
    },
    "ai_assistance": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4"]
    },
    "environment_scope": {
      "type": "string",
      "enum": ["PERSONAL_5070TI", "COMPANY_V100_INTERNAL", "RENTED_H100", "CPU_ONLY", "PAPER_ONLY"]
    },
    "evidence_type": {
      "type": "string",
      "enum": ["ORAL", "DERIVATION", "CODE", "DEBUG", "PROFILE", "DESIGN", "TRANSFER"]
    },
    "result_status": {
      "type": "string",
      "enum": ["PASS", "FAIL-MODEL", "FAIL-SYSTEM", "INCONCLUSIVE"]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["K", "A", "D", "E"],
      "properties": {
        "K": { "type": "number", "minimum": 0, "maximum": 4 },
        "A": { "type": "number", "minimum": 0, "maximum": 4 },
        "D": { "type": "number", "minimum": 0, "maximum": 4 },
        "E": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    },
    "run_manifest_ref": {
      "type": ["string", "null"],
      "description": "Project-relative reference only; never an external company path."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "exportable"],
        "properties": {
          "kind": { "type": "string" },
          "reference": { "type": "string" },
          "exportable": { "type": "boolean" }
        }
      }
    },
    "scoring_basis": { "type": "string", "minLength": 10 },
    "error_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CONCEPT",
          "MATH",
          "SHAPE",
          "DATA",
          "MASK",
          "NUMERIC",
          "OPTIMIZATION",
          "DISTRIBUTED",
          "PERFORMANCE",
          "CHECKPOINT",
          "EVALUATION",
          "EXPLANATION",
          "SAFETY",
          "MEASUREMENT",
          "NONE"
        ]
      }
    },
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_company_artifact", "approved_for_repository", "note"],
      "properties": {
        "contains_company_artifact": { "const": false },
        "approved_for_repository": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "regression_date": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
