{
  "name": "v100_dense",
  "purpose": "公司 8xV100 主线 dense 配置：MiniMindConfig 默认值（63.9M），seq 512，micro batch 保守",
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "use_moe": false,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "vocab_size": 6400,
    "max_position_embeddings": 32768,
    "rope_theta": 1000000.0,
    "rms_norm_eps": 1e-06,
    "num_experts": 4,
    "num_experts_per_tok": 1,
    "router_aux_loss_coef": 0.0005,
    "dropout": 0.0,
    "flash_attn": true,
    "tie_word_embeddings": true
  },
  "train": {
    "seq_len": 512,
    "global_batch": 64,
    "accum": 1,
    "lr": 0.0005,
    "grad_clip": 1.0,
    "data_seed": 1234,
    "note": "8 卡时 micro=8；单卡等价对照用 --accum 8（micro 仍为 8）"
  }
}
