{
  "name": "v100_moe",
  "purpose": "公司 8xV100 MoE 配置：198M 总量 / 约 64M 激活，4 experts top-1，aux coef 5e-4",
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "use_moe": true,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "vocab_size": 6400,
    "max_position_embeddings": 32768,
    "rope_theta": 1000000.0,
    "rms_norm_eps": 1e-06,
    "num_experts": 4,
    "num_experts_per_tok": 1,
    "norm_topk_prob": true,
    "router_aux_loss_coef": 0.0005,
    "dropout": 0.0,
    "flash_attn": true,
    "tie_word_embeddings": true
  },
  "train": {
    "seq_len": 512,
    "global_batch": 64,
    "accum": 1,
    "lr": 0.0005,
    "grad_clip": 1.0,
    "data_seed": 1234,
    "note": "EP=8 需要把 model.num_experts 改成 8（约束 ep_size<=num_experts 且整除）"
  }
}
