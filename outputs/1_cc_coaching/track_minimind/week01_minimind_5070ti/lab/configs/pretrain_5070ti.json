{
  "name": "pretrain_5070ti",
  "purpose": "有界 pretrain：与 train_pretrain.py 官方默认一致（max_seq_len 340, batch 32, accum 8, lr 5e-4, bf16）；16 GB 估算占用 <6 GB",
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "vocab_size": 6400
  },
  "train": {
    "max_seq_len": 340,
    "batch_size": 32,
    "accumulation_steps": 8,
    "learning_rate": 5e-4,
    "grad_clip": 1.0,
    "dtype": "bfloat16",
    "device": "cuda:0",
    "beta": 0.15
  },
  "stages": {},
  "data": {
    "pretrain": "$MINIMIND_ROOT/dataset/pretrain_t2t_mini.jsonl",
    "sft": "$MINIMIND_ROOT/dataset/sft_t2t_mini.jsonl",
    "dpo": "$MINIMIND_ROOT/dataset/dpo.jsonl"
  }
}
