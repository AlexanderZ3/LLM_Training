{
  "name": "smoke_5070ti",
  "purpose": "5070 Ti 上的 smoke：官方 64M 结构（768/8/8/4），短序列小 batch，只验证能跑、显存与吞吐量级（估算 <4 GB）",
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "vocab_size": 6400
  },
  "train": {
    "max_seq_len": 256,
    "batch_size": 8,
    "accumulation_steps": 1,
    "learning_rate": 5e-4,
    "grad_clip": 1.0,
    "dtype": "bfloat16",
    "device": "cuda:0",
    "beta": 0.15
  },
  "stages": {
    "sft": {"learning_rate": 1e-5},
    "dpo": {"learning_rate": 4e-8, "batch_size": 2, "max_seq_len": 512}
  },
  "data": {
    "pretrain": "$MINIMIND_ROOT/dataset/pretrain_t2t_mini.jsonl",
    "sft": "$MINIMIND_ROOT/dataset/sft_t2t_mini.jsonl",
    "dpo": "$MINIMIND_ROOT/dataset/dpo.jsonl"
  }
}
