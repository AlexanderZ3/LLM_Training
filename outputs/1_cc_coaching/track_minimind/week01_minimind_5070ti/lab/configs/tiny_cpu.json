{
  "name": "tiny_cpu",
  "purpose": "CPU 单测 / dry run 用的最小模型；不代表任何真实训练结果",
  "model": {
    "hidden_size": 64,
    "num_hidden_layers": 2,
    "num_attention_heads": 2,
    "num_key_value_heads": 1,
    "vocab_size": 6400,
    "max_position_embeddings": 512
  },
  "train": {
    "max_seq_len": 64,
    "batch_size": 2,
    "accumulation_steps": 1,
    "learning_rate": 5e-4,
    "grad_clip": 1.0,
    "dtype": "float32",
    "device": "cpu",
    "beta": 0.15
  },
  "stages": {
    "sft": {"learning_rate": 1e-4},
    "dpo": {"learning_rate": 1e-5, "max_seq_len": 64}
  },
  "data": {
    "pretrain": "fixture",
    "sft": "fixture",
    "dpo": "fixture"
  }
}
