{
  "name": "sft_5070ti",
  "purpose": "有界 full SFT：官方默认 max_seq_len 768 / lr 1e-5 / 有效 batch 16；16 GB 保守取物理 batch 8 × accum 2（估算占用 <8 GB）；DPO 段与 train_dpo.py 默认一致（beta 0.15, lr 4e-8, batch 4, seq 1024）",
  "model": {
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "vocab_size": 6400
  },
  "train": {
    "max_seq_len": 768,
    "batch_size": 8,
    "accumulation_steps": 2,
    "learning_rate": 1e-5,
    "grad_clip": 1.0,
    "dtype": "bfloat16",
    "device": "cuda:0",
    "beta": 0.15
  },
  "stages": {
    "dpo": {"learning_rate": 4e-8, "batch_size": 4, "accumulation_steps": 1, "max_seq_len": 1024}
  },
  "data": {
    "pretrain": "$MINIMIND_ROOT/dataset/pretrain_t2t_mini.jsonl",
    "sft": "$MINIMIND_ROOT/dataset/sft_t2t_mini.jsonl",
    "dpo": "$MINIMIND_ROOT/dataset/dpo.jsonl"
  }
}
