{
  "name": "smoke_v100",
  "tier": "smoke",
  "purpose": "V100 上 2 步以内跑完的 wiring smoke。用来验 torchrun/NCCL 通不通，不看数值。",
  "model": {
    "vocab_size": 6400,
    "hidden_size": 256,
    "num_hidden_layers": 4,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "intermediate_size": 832,
    "max_seq_len": 512,
    "rope_theta": 1000000.0,
    "norm_eps": 1e-05,
    "tie_embeddings": true,
    "dropout": 0.0
  },
  "train": {
    "seq_len": 128,
    "global_batch": 16,
    "accum": 1,
    "lr": 0.0005,
    "grad_clip": 1.0,
    "data_seed": 1234,
    "num_samples": 2048,
    "label_ignore_prefix": 32
  }
}
