{
  "name": "tiny_cpu",
  "tier": "tiny",
  "purpose": "CPU 单测与 dry-run 用的最小配置。秒级完成，形状与 V100 配置同构。",
  "model": {
    "vocab_size": 256,
    "hidden_size": 64,
    "num_hidden_layers": 2,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "intermediate_size": 128,
    "max_seq_len": 64,
    "rope_theta": 1000000.0,
    "norm_eps": 1e-05,
    "tie_embeddings": true,
    "dropout": 0.0
  },
  "train": {
    "seq_len": 32,
    "global_batch": 8,
    "accum": 1,
    "lr": 0.0005,
    "grad_clip": 1.0,
    "data_seed": 1234,
    "num_samples": 512,
    "label_ignore_prefix": 8
  }
}
