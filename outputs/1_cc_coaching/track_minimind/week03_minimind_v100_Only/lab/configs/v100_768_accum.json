{
  "name": "v100_768_accum",
  "tier": "full",
  "purpose": "与 v100_768 同一个全局批，但用 accum=4 换更小的 micro-batch。Day 3 显存对照组：global_batch 不变，activation 应降到 1/4。",
  "model": {
    "vocab_size": 6400,
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "intermediate_size": 2432,
    "max_seq_len": 512,
    "rope_theta": 1000000.0,
    "norm_eps": 1e-05,
    "tie_embeddings": true,
    "dropout": 0.0
  },
  "train": {
    "seq_len": 512,
    "global_batch": 64,
    "accum": 4,
    "lr": 0.0005,
    "grad_clip": 1.0,
    "data_seed": 1234,
    "num_samples": 8192,
    "label_ignore_prefix": 128
  }
}
