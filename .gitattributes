# 文本文件统一使用 LF，保证 Windows 和 Ubuntu 之间协作稳定。
* text=auto eol=lf

*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# 二进制文件不做换行符转换。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
*.gz    binary
*.7z    binary
*.mp4   binary
*.woff  binary
*.woff2 binary
